# =====================================================================
#  ECOWASmail Admin — Variables d'environnement
#  Copier ce fichier en ".env" et renseigner les vraies valeurs.
#  Le fichier .env ne doit JAMAIS être versionné ni exposé au web.
# =====================================================================

# --- Base de données -------------------------------------------------
# DB_DRIVER : "mysql" en production, "sqlite" pour un test local rapide.
DB_DRIVER=mysql

# Production (MySQL / MariaDB)
DB_HOST=localhost
DB_NAME=userdb_db
DB_USER=userdb_user
DB_PASS=change_me
DB_CHARSET=utf8mb4

# Test local (SQLite) — utilisé seulement si DB_DRIVER=sqlite.
# Chemin relatif à la racine du projet (créé automatiquement).
DB_SQLITE_PATH=database/local.sqlite

# --- SMTP principal (Office365) : mails destinés aux utilisateurs ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_AUTH=true
SMTP_USER=mailrelay@ecowas.int
SMTP_PASS=change_me
SMTP_FROM=webmaster@ecowas.int
SMTP_FROM_NAME="ECOWASmail Admin"

# --- SMTP relais interne : mails destinés à l'officier ECOLink -------
RELAY_HOST=eccprd.ecowas.int
RELAY_PORT=25
RELAY_AUTH=false
RELAY_USER=newecomail@ecowas.int

# --- Métier ----------------------------------------------------------
# Officier ECOLink / SAP qui reçoit les notifications de comptes SAP
ECOLINK_OFFICER=aoderinde@ecowas.int
# Domaine mail par défaut (comptes de la Commission)
DEFAULT_DOMAIN=ecowas.int

# --- Application -----------------------------------------------------
# Mettre "true" en développement pour afficher les erreurs détaillées
APP_DEBUG=false
